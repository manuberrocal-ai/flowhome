# Safe offline defaults. PUBLIC_* values are embedded in the static build.
# Select local, staging or production explicitly before enabling a service.
PUBLIC_APP_ENV=local
PUBLIC_AUTH_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_GTM_ID=
# Must match the reviewed Google tag destination in GTM; used for immediate opt-out.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_SUPABASE_URL=
# Use exactly one public key. Never use a secret or service_role key here.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_GOOGLE_CLIENT_ID=
# Build-only reviewed project identities; staging and production must be distinct.
FLOWHOME_SUPABASE_STAGING_REF=
FLOWHOME_SUPABASE_PRODUCTION_REF=
# Lifecycle remains deliberately inert until human-approved activation.
EMAIL_PROVIDER=mock
# Server-only: configure in Supabase Edge Function secrets, never in PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
LIFECYCLE_WORKER_SECRET=SERVER_ONLY
LIFECYCLE_TOKEN_SECRET=SERVER_ONLY
LIFECYCLE_WEBHOOK_SECRET=SERVER_ONLY
# Block 8 offers/trends remain inert until human-approved activation. See docs/BLOCK8_OFFER_TREND_RUNBOOK.md.
OFFER_SOURCE=Unknown
TREND_SOURCE=Unknown
DATA_STORE_URL=Unknown
PUBLIC_OFFERS_V1=off
# Block 9 uses Astro's canonical public boolean strings. It remains disabled without an approved graph provider.
PUBLIC_COMPATIBILITY_V1=false
PUBLIC_TREND_INGESTION_V1=off
# No Block 8 ingestion endpoint is implemented; no worker secret is configured.

# Review-only daily workflow. Secrets belong on the server, never PUBLIC_*.
FLOWHOME_TIMEZONE=America/Argentina/Buenos_Aires
DAILY_RUN_TIME=10:07
FLOWHOME_DAILY_SCHEDULE_ENABLED=false
FLOWHOME_DAILY_KILL_SWITCH=false
DAILY_AUTOPUBLISH=false
AMAZON_DISCOVERY_APPROVED=false
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_VERSION=3.1
AMAZON_PARTNER_TAG=flowhome-20
AMAZON_MARKETPLACE=www.amazon.com
