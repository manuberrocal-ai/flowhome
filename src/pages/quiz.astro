---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LifecycleCapture from '../components/LifecycleCapture.astro';
import {
  GOAL_QUIZ_OPTIONS,
  ECOSYSTEM_QUIZ_OPTIONS,
  BUDGET_QUIZ_OPTIONS,
  INSTALLATION_QUIZ_OPTIONS,
  EXTRA_PRIORITY_QUIZ_OPTIONS,
  getQuizStepLabel,
  prepareQuizCatalog,
} from '../lib/quiz-recommend';
import { getCompatibilityEnvironment } from '../lib/blocks/block9/runtime.ts';
import { getCommerceData } from '../lib/commerce-data';

const canonical = 'https://flowhome.dev/quiz/';
const products = await getCollection('products');
const compatibilityEnv = getCompatibilityEnvironment(import.meta.env);
const quizCatalog = prepareQuizCatalog(products
  .map((entry) => entry.data)
  .filter((data) => data.catalogActive)
  .map((data) => {
    const fields = data as Record<string, unknown>;
    const priceLastChecked = typeof fields.priceLastChecked === 'string' ? fields.priceLastChecked : '';
    const priceSource = typeof fields.priceSource === 'string' ? fields.priceSource as 'manual' | 'amazon-creators-api' | 'affiliate-feed' : undefined;
    const commerce = getCommerceData({ price: Number(data.price ?? 0), priceLastChecked, priceSource });
    return {
      slug: data.slug,
      name: data.name,
      brand: data.brand,
      price: Number(data.price ?? 0),
      priceLastChecked,
      priceSource: priceSource || '',
      priceLabel: commerce.priceLabel,
      category: data.category,
      catalogActive: true,
      ownerRating: Number(data.ownerRating ?? 0),
      ownerRatingCount: Number(data.ownerRatingCount ?? 0),
      ratingSource: typeof fields.ratingSource === 'string' ? fields.ratingSource : '',
      ratingLastChecked: typeof fields.ratingLastChecked === 'string' ? fields.ratingLastChecked : '',
      amazonUrl: data.affiliateUrl,
      image: data.image,
      priority: data.priority,
      alexaCompatible: Boolean(data.alexaCompatible),
      googleHomeCompatible: Boolean(data.googleHomeCompatible),
      appleHomeKit: Boolean(data.appleHomeKit),
      matter: Boolean(data.matter),
      zigbee: fields.zigbee === true,
      wifi: fields.wifi === true,
      appControl: fields.appControl === true,
      // Only surface the privacy signal when this field is actually present.
      hasSubscriptionRequired: Object.prototype.hasOwnProperty.call(fields, 'subscriptionRequired') && typeof fields.subscriptionRequired === 'boolean',
      subscriptionRequired: fields.subscriptionRequired === true,
    };
  }), compatibilityEnv);
const optionGroups = [GOAL_QUIZ_OPTIONS, ECOSYSTEM_QUIZ_OPTIONS, BUDGET_QUIZ_OPTIONS, INSTALLATION_QUIZ_OPTIONS, EXTRA_PRIORITY_QUIZ_OPTIONS];
const inputNames = ['quiz-goal', 'quiz-ecosystem', 'quiz-budget', 'quiz-installation', 'quiz-extra'];
---
<BaseLayout title="Smart Home Recommendation Quiz | FlowHome" description="Answer five quick questions for a transparent, catalog-driven smart-home shortlist." canonicalURL={canonical}>
  <section class="premium-page-hero">
    <p class="text-sm font-bold uppercase tracking-wide text-blue-700">Starter quiz</p>
    <h1 class="mt-2 text-4xl font-black text-slate-950 md:text-5xl">Find your smart home starter path</h1>
    <p class="mt-3 max-w-2xl text-lg leading-8 text-slate-600">Answer five quick questions. We rank catalog-active products and explain the recorded signals behind every match.</p>

    <form id="quiz-form" class="mt-8" aria-label="Smart home starter recommendation quiz" novalidate>
      {optionGroups.map((options, index) => (
        <fieldset data-quiz-step={index + 1} class:list={['quiz-step rounded-2xl border border-slate-200 bg-white p-6 shadow-sm', index > 0 && 'mt-4 hidden']} hidden={index > 0}>
          <legend class="text-sm font-black uppercase tracking-wide text-blue-700">Step {index + 1} — {getQuizStepLabel(index + 1)}</legend>
          <div class="mt-4 grid gap-3 md:grid-cols-3" role="radiogroup" aria-label={getQuizStepLabel(index + 1)}>
            {options.map((option) => (
              <label class="quiz-option group cursor-pointer rounded-2xl border border-slate-200 p-4 transition hover:border-blue-300 hover:shadow-md focus-within:ring-4 focus-within:ring-blue-100">
                <input type="radio" name={inputNames[index]} value={option.id} class="sr-only quiz-radio" data-quiz-input />
                <strong class="block text-base text-slate-950">{option.heading}</strong>
                <span class="mt-1 block text-sm text-slate-600">{option.description}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button type="button" id="quiz-back" class="hidden min-h-11 rounded-2xl border border-slate-200 px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-blue-100">Back</button>
        <button type="button" id="quiz-next" class="min-h-11 rounded-2xl bg-blue-700 px-5 py-2.5 text-sm font-black text-white transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" disabled>Continue</button>
        <button type="button" id="quiz-submit" class="hidden min-h-11 rounded-2xl bg-orange-600 px-5 py-2.5 text-sm font-black text-white transition hover:bg-orange-700 focus:outline-none focus:ring-4 focus:ring-orange-300" disabled>See my recommendations</button>
      </div>
    </form>

    <section id="quiz-results" class="mt-8 hidden" hidden tabindex="-1" aria-labelledby="quiz-results-title" aria-live="polite">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><h2 id="quiz-results-title" class="text-2xl font-black text-slate-950">Your starter shortlist</h2><p id="quiz-results-summary" class="mt-2 max-w-2xl text-sm leading-7 text-slate-600"></p></div>
        <button type="button" id="quiz-edit" class="min-h-11 rounded-2xl border border-slate-200 px-5 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-blue-100">Edit answers</button>
      </div>
      <p id="quiz-relaxed-notice" class="mt-3 hidden rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-950" role="status"></p>
      <p class="mt-3 text-xs text-slate-500">Prices are snapshots and availability changes on Amazon. FlowHome may earn from qualifying purchases.</p>
       <div id="quiz-results-cards" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"></div>
       <LifecycleCapture />
       <button type="button" id="quiz-restart" class="mt-6 min-h-11 rounded-2xl border border-slate-200 px-5 py-2.5 text-sm font-bold text-slate-700 hover:border-blue-300 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-100">Start over</button>
    </section>
    <p id="quiz-progress" class="mt-4 text-xs font-bold uppercase tracking-wide text-slate-500" aria-live="polite">Step 1 of 5</p>
  </section>

  <script type="application/json" id="quiz-catalog" set:html={JSON.stringify(quizCatalog).replaceAll('<', '\\u003c')}></script>
  <script>
    import { createInitialQuizState, getRecommendationReasons, isCompleteQuizState, parseQuizState, selectRecommendationResult, serializeQuizState } from '../lib/quiz-recommend';
    import { trackEvent } from '../lib/analytics';
    import { queueQuizCompletion, resetQuizCompletionDedupe } from '../lib/quiz-analytics';
    import { getCartStore } from '../lib/cart-store.js';

    type QuizState = ReturnType<typeof createInitialQuizState>;
    type QuizKey = keyof QuizState;
    type QuizCatalog = Parameters<typeof selectRecommendationResult>[1];
    type QuizProduct = ReturnType<typeof selectRecommendationResult>['recommendations'][number];
    type QuizResult = ReturnType<typeof selectRecommendationResult>;
    const requiredElement = <T extends Element>(selector: string): T => {
      const element = document.querySelector<T>(selector);
      if (!element) throw new Error(`Quiz page is missing required element: ${selector}`);
      return element;
    };
    const keys: QuizKey[] = ['goal', 'ecosystem', 'budget', 'installation', 'extra'];
    const names: string[] = ['quiz-goal', 'quiz-ecosystem', 'quiz-budget', 'quiz-installation', 'quiz-extra'];
    const catalogPayload = requiredElement<HTMLScriptElement>('#quiz-catalog');
    const catalog: QuizCatalog = JSON.parse(catalogPayload.textContent || '[]');
    const form = requiredElement<HTMLFormElement>('#quiz-form');
    const stepEls = [...document.querySelectorAll<HTMLFieldSetElement>('[data-quiz-step]')];
    const backBtn = requiredElement<HTMLButtonElement>('#quiz-back');
    const nextBtn = requiredElement<HTMLButtonElement>('#quiz-next');
    const submitBtn = requiredElement<HTMLButtonElement>('#quiz-submit');
    const results = requiredElement<HTMLElement>('#quiz-results');
    const cards = requiredElement<HTMLElement>('#quiz-results-cards');
    const summary = requiredElement<HTMLElement>('#quiz-results-summary');
    const relaxedNotice = requiredElement<HTMLElement>('#quiz-relaxed-notice');
    const progress = requiredElement<HTMLElement>('#quiz-progress');
    const store = getCartStore();
    let state: QuizState = parseQuizState(window.location.search);
    let step = Math.max(1, keys.findIndex((key) => !state[key]) + 1 || 5);
    let quizStarted = false;

    const htmlEscapes: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => htmlEscapes[character] ?? '');
    const price = (value: unknown) => `$${Number(value || 0).toFixed(2)}`;
    const updateUrl = () => history.replaceState({ quiz: state }, '', `${window.location.pathname}${serializeQuizState(state) ? `?${serializeQuizState(state)}` : ''}`);
    const inputFor = (index: number, value: string) => document.querySelector<HTMLInputElement>(`[data-quiz-step="${index + 1}"] input[value="${CSS.escape(value)}"]`);

    function isFilled(index: number) {
      const key = keys[index];
      return Boolean(key && state[key]);
    }
    function syncOptions() {
      keys.forEach((key, index) => {
        const fieldset = stepEls[index];
        if (!fieldset) return;
        fieldset.querySelectorAll<HTMLInputElement>('.quiz-radio').forEach((input) => { input.checked = input.value === state[key]; });
        fieldset.querySelectorAll<HTMLLabelElement>('.quiz-option').forEach((label) => label.classList.toggle('border-blue-500', label.querySelector<HTMLInputElement>('.quiz-radio')?.checked ?? false));
        fieldset.querySelectorAll<HTMLLabelElement>('.quiz-option').forEach((label) => label.classList.toggle('bg-blue-50', label.querySelector<HTMLInputElement>('.quiz-radio')?.checked ?? false));
      });
    }
    function showStep(focus = false) {
      stepEls.forEach((field, index) => { const visible = index + 1 === step; field.hidden = !visible; field.classList.toggle('hidden', !visible); });
      backBtn.classList.toggle('hidden', step === 1);
      nextBtn.classList.toggle('hidden', step === 5);
      submitBtn.classList.toggle('hidden', step !== 5);
      nextBtn.disabled = !isFilled(step - 1);
      submitBtn.disabled = !isFilled(4);
      progress.textContent = `Step ${step} of 5`;
      const currentKey = keys[step - 1];
      const currentStep = stepEls[step - 1];
      if (focus && currentKey && currentStep) (inputFor(step - 1, state[currentKey]) || currentStep.querySelector<HTMLInputElement>('.quiz-radio'))?.focus();
    }
    function renderCards(recommendations: QuizProduct[], result: QuizResult) {
      cards.innerHTML = recommendations.map((product) => {
        const reasons = getRecommendationReasons(product, state, result).map((reason) => `<li>${escapeHtml(reason)}</li>`).join('');
        const productUrl = `/product/${encodeURIComponent(product.slug)}/`;
        const saved = store.hasItem(product.slug);
        return `<article class="quiz-result-card flex h-full flex-col rounded-[1.6rem] border border-slate-200 bg-slate-50 p-4 shadow-sm">
          <a href="${productUrl}" class="block"><p class="text-[11px] font-black uppercase tracking-[0.18em] text-blue-700">${escapeHtml(product.brand)}</p><h3 class="mt-1 text-base font-black leading-snug text-slate-950">${escapeHtml(product.name)}</h3></a>
          <p class="mt-2 text-sm font-bold text-slate-700">${escapeHtml(product.priceLabel === 'Price snapshot' ? 'Price snapshot' : 'Historical price snapshot')}: ${escapeHtml(price(product.price))}</p>
          ${(product.priceSource || product.priceLastChecked) ? `<p class="mt-1 text-xs text-slate-500">Price source: ${escapeHtml(product.priceSource || 'not recorded')}${product.priceLastChecked ? ` · checked ${escapeHtml(product.priceLastChecked)}` : ''}</p>` : ''}
          ${Number(product.ownerRating) > 0 ? `<p class="mt-1 text-xs text-slate-500">${escapeHtml(product.ratingSource || 'Owner rating')}: ${escapeHtml(product.ownerRating)} / 5${product.ratingLastChecked ? ` · checked ${escapeHtml(product.ratingLastChecked)}` : ''}</p>` : ''}
          <div class="mt-3 flex flex-wrap gap-1.5" aria-label="Recorded compatibility signals">${[[product.matter, 'Matter'], [product.zigbee, 'Zigbee'], [product.alexaCompatible, 'Alexa'], [product.googleHomeCompatible, 'Google Home'], [product.appleHomeKit, 'Apple Home']].filter(([enabled]) => enabled).map(([, label]) => `<span class="rounded-full bg-teal-50 px-2 py-1 text-[10px] font-black uppercase text-teal-700">${escapeHtml(label)}</span>`).join('') || '<span class="text-xs text-slate-500">No compatibility signal verified in this catalog.</span>'}</div>
          <div class="mt-3 rounded-xl bg-white p-3"><h4 class="text-xs font-black uppercase tracking-wide text-slate-700">Why this matches</h4><ul class="mt-2 list-disc space-y-1 pl-4 text-xs leading-5 text-slate-600">${reasons}</ul></div>
          <div class="mt-auto flex flex-wrap gap-2 pt-4"><button type="button" class="quiz-save inline-flex min-h-11 items-center justify-center rounded-2xl border border-slate-300 px-3 py-2 text-xs font-black text-slate-800 focus:outline-none focus:ring-4 focus:ring-blue-100" data-quiz-save data-slug="${escapeHtml(product.slug)}" aria-pressed="${saved}" aria-label="${saved ? 'Remove' : 'Save'} ${escapeHtml(product.name)} from your FlowHome list">${saved ? 'Saved' : 'Save'}</button><a href="${productUrl}" class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700" aria-label="View ${escapeHtml(product.name)} details">Details</a><a href="${escapeHtml(product.amazonUrl)}" target="_blank" rel="nofollow sponsored noopener noreferrer" data-fh-amazon-cta data-product-slug="${escapeHtml(product.slug)}" data-category="${escapeHtml(product.category)}" data-cta-position="quiz_result" data-discount="0" class="inline-flex min-h-11 items-center justify-center rounded-2xl bg-orange-600 px-3 py-2 text-xs font-black text-white" aria-label="Check ${escapeHtml(product.name)} on Amazon">Amazon</a></div>
        </article>`;
      }).join('');
      cards.querySelectorAll<HTMLButtonElement>('[data-quiz-save]').forEach((button) => button.addEventListener('click', () => {
        const product = recommendations.find((item) => item.slug === button.dataset.slug);
        if (product) store.toggle({ asin: product.asin, slug: product.slug, name: product.name, price: product.price, image: product.image, url: `/product/${product.slug}/` });
      }));
    }
    function renderResults(trackCompletion = true) {
      if (!isCompleteQuizState(state)) return;
      const result = selectRecommendationResult(state, catalog, 4);
      summary.textContent = result.recommendations.length ? `These ${result.recommendations.length} catalog-active products match your answers using recorded catalog signals.` : 'No catalog-active products match this combination yet. Edit answers to widen the fit.';
      relaxedNotice.hidden = result.relaxedFilters.length === 0;
      relaxedNotice.textContent = result.relaxedFilters.length ? `To show enough goal-category matches, we relaxed: ${result.relaxedFilters.join(', ')}. Check each product listing before buying.` : '';
      renderCards(result.recommendations, result);
      form.hidden = true; form.classList.add('hidden'); results.hidden = false; results.classList.remove('hidden'); progress.textContent = 'Recommendations ready';
      if (trackCompletion) queueQuizCompletion({ ...state, result_count: result.recommendations.length, page_type: 'quiz' });
      results.focus?.();
    }
    document.addEventListener('change', (event: Event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !input.classList.contains('quiz-radio')) return;
      const index = names.indexOf(input.name); if (index < 0) return;
      const key = keys[index];
      if (!key) return;
      const nextParams = new URLSearchParams(serializeQuizState(state));
      nextParams.set(key, input.value);
      state = parseQuizState(nextParams); syncOptions(); showStep(); updateUrl();
      if (!quizStarted) { quizStarted = true; trackEvent('quiz_start', { page_type: 'quiz' }); }
    });
    nextBtn.addEventListener('click', () => { if (isFilled(step - 1) && step < 5) { step += 1; showStep(true); } });
    backBtn.addEventListener('click', () => { if (step > 1) { step -= 1; showStep(true); } });
    submitBtn.addEventListener('click', () => renderResults(true));
    requiredElement<HTMLButtonElement>('#quiz-edit').addEventListener('click', () => { results.hidden = true; results.classList.add('hidden'); form.hidden = false; form.classList.remove('hidden'); step = 5; showStep(true); });
    requiredElement<HTMLButtonElement>('#quiz-restart').addEventListener('click', () => { resetQuizCompletionDedupe(); state = createInitialQuizState(); step = 1; quizStarted = false; results.hidden = true; results.classList.add('hidden'); form.hidden = false; form.classList.remove('hidden'); syncOptions(); showStep(true); updateUrl(); });
    store.subscribe(() => {
      if (!results.hidden && isCompleteQuizState(state)) {
        const result = selectRecommendationResult(state, catalog, 4);
        renderCards(result.recommendations, result);
      }
    });
    window.addEventListener('popstate', () => {
      state = parseQuizState(window.location.search);
      step = Math.max(1, keys.findIndex((key) => !state[key]) + 1 || 5);
      results.hidden = true; results.classList.add('hidden'); form.hidden = false; form.classList.remove('hidden');
      syncOptions();
      if (isCompleteQuizState(state)) renderResults(false);
      else showStep();
    });
    syncOptions();
    if (isCompleteQuizState(state)) renderResults(false);
    else showStep();
  </script>
</BaseLayout>
