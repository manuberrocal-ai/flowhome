---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductImage } from '../lib/product-art';
import { getCommerceData } from '../lib/commerce-data';

const products = (await getCollection('products')).map((product) => {
  const commerce = getCommerceData(product.data);
  return {
    name: product.data.name,
    slug: product.data.slug,
    brand: product.data.brand,
    category: product.data.category,
    asin: product.data.asin,
    affiliateUrl: product.data.affiliateUrl,
    ownerRating: commerce.displayRating,
    ownerRatingCount: commerce.displayRatingCount,
    ratingLastChecked: commerce.ratingCapturedAt,
    ratingSource: commerce.isRatingFresh ? 'amazon-creators-api' : undefined,
    ratingValidUntil: commerce.ratingExpiresAt,
    price: commerce.displayPrice,
    priceSource: commerce.isPriceFresh ? 'amazon-creators-api' : undefined,
    priceLastChecked: commerce.priceCapturedAt,
    priceValidUntil: commerce.priceExpiresAt,
    priceLabel: commerce.priceLabel,
    image: getProductImage(product.data),
  };
});
---
<BaseLayout title="Search Smart Home Products | FlowHome" description="Search FlowHome smart home products, categories, and brands." canonicalURL="https://flowhome.dev/search/" noindex>
  <section class="premium-page-hero">
    <p class="text-sm font-bold uppercase tracking-wide text-blue-700">Search</p>
    <h1 class="mt-2 text-4xl font-black text-slate-950">Search FlowHome</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600">Find smart home products by brand, category, or product name.</p>
    <label for="site-search" class="mt-6 block font-bold text-slate-950">Search products</label>
    <input id="site-search" type="search" placeholder="Try robot vacuum, camera, thermostat..." class="mt-2 w-full rounded-2xl border border-slate-300 px-5 py-4 text-lg placeholder:text-slate-600 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
  </section>
  <noscript><p class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 text-slate-700">Interactive search requires JavaScript. You can still <a href="/products/" class="underline">browse the complete product catalog</a>.</p></noscript>
  <p id="search-status" role="status" aria-atomic="true" class="mt-8 text-sm font-semibold text-slate-600"></p>
  <div id="search-empty" hidden class="mt-4 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-bold text-slate-950">No matching products</h2>
    <p class="mt-2 text-slate-600">Try a different product name, brand, or category, or clear your search to see every product.</p>
    <button id="search-clear" type="button" class="mt-4 rounded-xl bg-brand-dark px-5 py-3 font-bold text-white">Clear search</button>
    <a href="/products/" class="ml-3 inline-block py-3 font-semibold text-brand underline underline-offset-4">Browse the catalog</a>
  </div>
  <section id="search-results" aria-label="Product results" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-search-products={JSON.stringify(products)}></section>
  <script>
    import { matchesCatalogQuery } from '../lib/catalog-filter.js';
    import { getProductThumbnailSet } from '../lib/product-thumbnails';
    import { getProductImageAlt, getProductImageSourceLabel } from '../lib/product-art';
    import { getCommerceData, type CommerceProduct } from '../lib/commerce-data';
    type SearchProduct = CommerceProduct & {
      name: string;
      slug: string;
      brand: string;
      category: string;
      priceLabel: string;
      image: string;
    };
    const requiredElement = <T extends Element>(selector: string): T => {
      const element = document.querySelector<T>(selector);
      if (!element) throw new Error(`Search page is missing required element: ${selector}`);
      return element;
    };
    const input = requiredElement<HTMLInputElement>('#site-search');
    const results = requiredElement<HTMLElement>('#search-results');
    const status = requiredElement<HTMLElement>('#search-status');
    const empty = requiredElement<HTMLElement>('#search-empty');
    const clear = requiredElement<HTMLButtonElement>('#search-clear');
    const products: SearchProduct[] = JSON.parse(results.dataset.searchProducts || '[]');
    const htmlEscapes: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' };
    function escapeHtml(value: unknown) {
      return String(value).replace(/[&<>'"]/g, (character) => htmlEscapes[character] ?? '');
    }
    function render(query = '') {
      const q = query.trim().toLowerCase();
      const filtered = products.filter((item) => matchesCatalogQuery(item, q));
      status.textContent = q
        ? `${filtered.length} ${filtered.length === 1 ? 'product' : 'products'} found.`
        : `Showing all ${filtered.length} products.`;
      empty.hidden = filtered.length !== 0;
      results.innerHTML = filtered.map((item) => {
        const category = item.category.replaceAll('-', ' ');
        const commerce = getCommerceData(item);
        return '<article data-image-fallback-scope class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">' +
          '<a href="/product/' + encodeURIComponent(item.slug) + '/" class="block">' +
          '<img src="' + escapeHtml(item.image) + '" srcset="' + escapeHtml(getProductThumbnailSet(item)) + '" sizes="104px" alt="' + escapeHtml(getProductImageAlt(item)) + '" class="mx-auto h-32 w-full object-contain rounded-xl bg-slate-100 p-3" width="320" height="128" loading="lazy" decoding="async" data-fallback-src="/images/product-placeholder.svg" />' +
          '<p class="mt-2 text-xs text-slate-600" data-image-source-caption>' + escapeHtml(getProductImageSourceLabel(item)) + '</p>' +
          '<h2 class="mt-4 text-lg font-extrabold text-slate-950">' + escapeHtml(item.name) + '</h2>' +
          '<p class="mt-1 text-sm text-slate-500">' + escapeHtml(item.brand) + ' · ' + escapeHtml(category) + '</p>' +
          '<p class="mt-2 font-bold text-blue-700">' + (commerce.displayPrice === undefined ? 'View product details' : escapeHtml(item.priceLabel) + ': $' + escapeHtml(commerce.displayPrice)) + '</p>' +
          (commerce.isRatingFresh ? '<p class="mt-1 text-xs text-slate-500">Amazon customer rating ' + escapeHtml(commerce.displayRating) + ' / 5 · checked ' + escapeHtml(commerce.ratingLastCheckedLabel) + '</p>' : '') +
          '</a></article>';
      }).join('');
    }
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    input.addEventListener('input', (event) => {
      if (event.target instanceof HTMLInputElement) render(event.target.value);
    });
    input.value = initialQuery;
    render(initialQuery);
    clear.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
  </script>
</BaseLayout>
