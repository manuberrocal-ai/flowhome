---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealCard from '../../components/DealCard.astro';
import { getDealStatus } from '../../lib/deal-state';
import { getCommerceData } from '../../lib/commerce-data';

// Live deals first, then upcoming. Expired deals are intentionally hidden from
// the promoted deals hub. They may still appear on product pages as historical
// snapshots (labelled by DealCard), but never with urgency messaging.
const allDeals = await getCollection('deals');
const products = await getCollection('products');
const now = new Date();
const visibleDeals = allDeals
  .map((deal) => ({ deal, status: getDealStatus({ start: deal.data.startDate, end: deal.data.endDate }, now).status }))
  .filter((entry) => {
    const product = products.find((p) => p.data.slug === entry.deal.data.productSlug && p.data.asin === entry.deal.data.asin);
    return entry.status === 'active' && product && getCommerceData(product.data, now).showPromotion
      && product.data.price === entry.deal.data.dealPrice;
  })
  .sort((a, b) => {
    if (a.status !== b.status) return a.status === 'active' ? -1 : 1;
    return b.deal.data.discountPct - a.deal.data.discountPct;
  })
  .map((entry) => entry.deal);
---
<BaseLayout title="Smart Home Deals | FlowHome" description="Check verified active smart-home offers when available, or research products and review your saved list." canonicalURL="https://flowhome.dev/deals/">
  <section>
    <p class="text-sm font-bold uppercase tracking-wide text-blue-700">Price checks</p>
    <h1 class="mt-2 text-3xl font-black text-slate-950 sm:text-4xl">Smart home deals</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600">Only verified active offers appear here. Confirm the final price and any conditions on Amazon before buying.</p>
  </section>
  <section class="mt-8 grid gap-6 lg:grid-cols-2" aria-label="Available offers">
    {visibleDeals.length === 0 ? (
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 lg:col-span-2" data-deals-empty>
        <h2 class="text-2xl font-bold text-slate-950">No verified active deals right now</h2>
        <p class="mt-3 max-w-2xl leading-7 text-slate-600">You can still compare setup requirements and save the models you want to check. Check current prices on each product's Amazon listing.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/products/" class="inline-flex min-h-11 items-center rounded-xl bg-slate-900 px-5 py-3 font-bold text-white hover:bg-slate-700">Browse products</a>
          <a href="/cart/" class="inline-flex min-h-11 items-center rounded-xl border border-slate-300 px-5 py-3 font-bold text-slate-900 hover:bg-slate-50">Review saved list</a>
        </div>
        <p class="mt-5 text-sm text-slate-600">Not sure where to start? <a href="/compare/" class="inline-flex min-h-11 items-center font-bold text-blue-700 underline underline-offset-4">Explore product comparisons</a></p>
      </div>
    ) : (
      visibleDeals.map((deal) => <DealCard deal={deal} product={products.find((p) => p.data.slug === deal.data.productSlug)} />)
    )}
  </section>
</BaseLayout>
