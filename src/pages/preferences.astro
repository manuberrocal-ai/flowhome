---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Email preferences | FlowHome" description="Manage optional FlowHome lifecycle email preferences." canonicalURL="https://flowhome.dev/preferences/" noindex={true}>
  <article class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
    <p class="text-sm font-black uppercase tracking-wide text-blue-700">Optional lifecycle email</p><h1 class="mt-2 text-4xl font-black text-slate-950">Email preferences</h1>
    <p class="mt-3 text-slate-600">Analytics choices are separate. Sign in only to keep optional preferences across devices.</p>
    <p class="mt-3 text-sm text-slate-600">Unsubscribing immediately prevents future provider authorization. A call already authorized immediately before sending during the documented 60-second lease window may still complete and cannot be recalled.</p>
    <p data-lifecycle-status class="mt-4 rounded-xl bg-slate-50 p-3 text-sm font-bold text-slate-700" aria-live="polite">Checking secure preference access…</p>
    <div data-lifecycle-signed-out hidden class="mt-5"><a href="/account/?return=%2Fpreferences%2F" class="inline-flex min-h-11 items-center rounded-xl bg-slate-950 px-4 py-2 font-bold text-white">Sign in to manage preferences</a></div>
    <form data-lifecycle-preferences hidden class="mt-6 space-y-5" novalidate>
      <fieldset><legend class="font-black text-slate-950">Topics</legend><div class="mt-2 grid gap-2 sm:grid-cols-2" data-lifecycle-categories></div></fieldset>
      <label class="block font-bold text-slate-800">Market<select name="market" class="mt-1 min-h-11 w-full rounded-xl border border-slate-300 px-3"><option value="US">United States</option></select></label>
      <label class="block font-bold text-slate-800">Frequency<select name="frequency" class="mt-1 min-h-11 w-full rounded-xl border border-slate-300 px-3"><option value="weekly">Weekly digest</option><option value="monthly">Monthly digest</option><option value="important-only">Important alerts only</option></select></label>
      <fieldset><legend class="font-black text-slate-950">Update types</legend><div class="mt-2 grid gap-2 sm:grid-cols-2" data-lifecycle-types></div></fieldset>
      <label class="flex gap-2 text-sm leading-5 text-slate-700"><input name="consent" type="checkbox" required class="mt-1 h-4 w-4" /> I explicitly consent to these optional lifecycle emails and understand I can unsubscribe at any time.</label>
      <div class="flex flex-wrap gap-3"><button type="submit" data-lifecycle-save class="min-h-11 rounded-xl bg-slate-950 px-4 py-2 font-bold text-white">Save preferences</button><button type="button" data-lifecycle-unsubscribe class="min-h-11 rounded-xl border border-red-200 px-4 py-2 font-bold text-red-800">Unsubscribe now</button><button type="button" data-lifecycle-export class="min-h-11 rounded-xl border border-slate-300 px-4 py-2 font-bold">Export</button><button type="button" data-lifecycle-delete class="min-h-11 rounded-xl border border-slate-300 px-4 py-2 font-bold">Delete lifecycle data</button></div>
    </form>
  </article>
  <script>
    import { LIFECYCLE_CATEGORIES, LIFECYCLE_TYPES } from '../lib/lifecycle-preferences.js';
    import { consumeUnsubscribeFragment, deleteLifecycleData, exportLifecycleData, getLifecyclePreferences, saveLifecyclePreferences, unsubscribeLifecyclePreferences, unsubscribeLifecycleToken } from '../lib/lifecycle-client.js';
    import { getSupabaseClient } from '../lib/supabase-client';
    const labels = (value: string) => value.replaceAll('-', ' ');
    const form = document.querySelector<HTMLFormElement>('[data-lifecycle-preferences]')!;
    const status = document.querySelector<HTMLElement>('[data-lifecycle-status]')!;
    const signedOut = document.querySelector<HTMLElement>('[data-lifecycle-signed-out]')!;
    const render = (selector: string, name: string, values: readonly string[]) => { const target = document.querySelector(selector)!; target.innerHTML = values.map((value) => `<label class="text-sm"><input type="checkbox" name="${name}" value="${value}" /> ${labels(value)}</label>`).join(''); };
    const setStatus = (message: string) => { status.textContent = message; };
    const setBusy = (button: HTMLButtonElement, busy: boolean, label: string) => { button.disabled = busy; button.setAttribute('aria-busy', String(busy)); if (busy) button.dataset.label = button.textContent || ''; button.textContent = busy ? label : button.dataset.label || button.textContent; };
    render('[data-lifecycle-categories]', 'category', LIFECYCLE_CATEGORIES); render('[data-lifecycle-types]', 'type', LIFECYCLE_TYPES);
    const client = getSupabaseClient(); const token = consumeUnsubscribeFragment();
    if (token) { unsubscribeLifecycleToken(token, client).then(() => setStatus('Unsubscribed: future provider authorization has stopped immediately. An already-authorized call may still complete.')).catch(() => setStatus('We could not verify that unsubscribe link.')); }
    (async () => { try { const { data } = await client?.auth.getSession() || {}; if (!data?.session) { signedOut.hidden = false; if (!token) setStatus('Sign in is required to manage persistent preferences.'); return; } const preferences = await getLifecyclePreferences(client); form.market.value = preferences.market; form.frequency.value = preferences.frequency; preferences.categories.forEach((value) => (form.querySelector<HTMLInputElement>(`[name="category"][value="${value}"]`)!.checked = true)); preferences.types.forEach((value) => (form.querySelector<HTMLInputElement>(`[name="type"][value="${value}"]`)!.checked = true)); form.querySelector<HTMLInputElement>('[name="consent"]')!.checked = false; form.hidden = false; setStatus('Choose preferences and explicitly confirm consent before saving.'); } catch { setStatus('Secure preference access is unavailable. No changes were made.'); } })();
    form.addEventListener('submit', async (event) => { event.preventDefault(); const button = document.querySelector<HTMLButtonElement>('[data-lifecycle-save]')!; if (!form.checkValidity()) { form.reportValidity(); return; } setBusy(button, true, 'Saving…'); try { const values = new FormData(form); await saveLifecyclePreferences({ categories: values.getAll('category'), types: values.getAll('type'), market: values.get('market'), frequency: values.get('frequency'), consent: values.get('consent') === 'on' }, client); setStatus('Preferences saved.'); form.querySelector<HTMLInputElement>('[name="consent"]')!.checked = false; } catch { setStatus('Preferences were not changed. Please try again later.'); } finally { setBusy(button, false, ''); } });
    document.querySelector<HTMLButtonElement>('[data-lifecycle-unsubscribe]')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; setBusy(button, true, 'Unsubscribing…'); try { await unsubscribeLifecyclePreferences('account', client); setStatus('Unsubscribed: future provider authorization has stopped immediately. An already-authorized call may still complete.'); } catch { setStatus('We could not unsubscribe you.'); } finally { setBusy(button, false, ''); } });
    document.querySelector<HTMLButtonElement>('[data-lifecycle-export]')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; setBusy(button, true, 'Preparing…'); try { const data = await exportLifecycleData(client); const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })); link.download = 'flowhome-lifecycle-export.json'; link.click(); URL.revokeObjectURL(link.href); setStatus('Your lifecycle export was prepared locally.'); } catch { setStatus('We could not prepare an export.'); } finally { setBusy(button, false, ''); } });
    document.querySelector<HTMLButtonElement>('[data-lifecycle-delete]')?.addEventListener('click', async (event) => { if (!window.confirm('Delete optional lifecycle data and cancel pending email jobs?')) return; const button = event.currentTarget as HTMLButtonElement; setBusy(button, true, 'Deleting…'); try { await deleteLifecycleData(client); form.hidden = true; setStatus('Lifecycle data deleted and pending jobs cancelled.'); } catch { setStatus('Lifecycle data was not deleted.'); } finally { setBusy(button, false, ''); } });
  </script>
</BaseLayout>
