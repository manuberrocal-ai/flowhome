---
interface Props { product: any; }
const { product } = Astro.props;
const data = product.data ?? product;
import { getCommerceData } from '../lib/commerce-data';
const commerce = getCommerceData(data);
---
<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-xl font-extrabold">{commerce.priceLabel}</h2>
  <p class="mt-2 text-sm text-slate-600">{commerce.priceLabel}. This is a single recorded observation, not a price history or live listing.</p>
  <div class="mt-4 rounded-xl bg-slate-100 p-4 text-sm">
    <div class="font-bold text-slate-500">Recorded price</div><div class="text-2xl font-black text-blue-700">${data.price}</div>
    <p class="mt-2 text-slate-600">Source: {commerce.priceSourceLabel}{commerce.priceLastCheckedLabel ? ` · Price last checked ${commerce.priceLastCheckedLabel}` : ''}</p>
  </div>
</div>
