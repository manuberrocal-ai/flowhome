---
import { getCommerceData } from '../lib/commerce-data';
import type { CommerceProduct } from '../lib/commerce-data';

interface ComparisonProduct extends CommerceProduct {
  slug: string;
  name: string;
  ownerRating?: number;
  ownerRatingCount?: number;
  ratingLastChecked?: string;
  matter?: boolean;
  alexaCompatible?: boolean;
  googleHomeCompatible?: boolean;
  appleHomeKit?: boolean;
  energyMonitoring?: boolean;
  category?: string;
  affiliateUrl?: string;
  compatibilityVerificationEnabled?: boolean;
}

interface Props { products: ComparisonProduct[]; }
type ComparisonRow = readonly [string, (product: ComparisonProduct) => string];

const { products } = Astro.props;
const commerceBySlug = new Map(products.map((p) => [p.slug, getCommerceData(p)]));
function compatibilityLabel(product: ComparisonProduct, field: 'matter' | 'alexaCompatible' | 'googleHomeCompatible' | 'appleHomeKit'): string {
  if (product.compatibilityVerificationEnabled && product[field] === undefined) return 'Unknown';
  return product[field] ? 'Yes' : 'No';
}
const rows: ComparisonRow[] = [
  ['Price', (p) => {
    const c = commerceBySlug.get(p.slug) ?? getCommerceData(p);
    return `${c.priceLabel}: $${p.price}${c.priceLastCheckedLabel ? ` (checked ${c.priceLastCheckedLabel})` : ''}`;
  }],
  ['Price source', (p) => {
    const c = commerceBySlug.get(p.slug) ?? getCommerceData(p);
    return c.priceSourceLabel;
  }],
  ['Amazon customer rating', (p) => `${p.ownerRating} / 5`],
  ['Amazon rating count', (p) => `${p.ownerRatingCount?.toLocaleString() ?? p.ownerRatingCount}`],
  ['Rating checked', (p) => p.ratingLastChecked ?? 'Not recorded'],
  ['Matter', (p) => compatibilityLabel(p, 'matter')],
  ['Alexa', (p) => compatibilityLabel(p, 'alexaCompatible')],
  ['Google Home', (p) => compatibilityLabel(p, 'googleHomeCompatible')],
  ['Apple HomeKit', (p) => compatibilityLabel(p, 'appleHomeKit')],
  ['Energy monitoring', (p) => p.energyMonitoring ? 'Yes' : 'No'],
];
---
<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
  <table class="compare-table min-w-full text-sm">
    <caption>Side-by-side verified product data comparison; horizontal scrolling is available on narrow screens.</caption>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        {products.map((product) => <th scope="col" class="min-w-48">{product.name}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map(([label, getter]) => <tr><th scope="row" class="font-bold text-slate-700">{label}</th>{products.map((product) => <td>{getter(product)}</td>)}</tr>)}
      <tr>
        <th scope="row" class="font-bold text-slate-700">Listing link</th>
        {products.map((product) => <td><a href={product.affiliateUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" class="font-bold text-blue-700 hover:underline" data-fh-amazon-cta data-product-slug={product.slug} data-category={product.category} data-discount={product.discountPct} data-cta-position="compare_table">Check on Amazon</a></td>)}
      </tr>
    </tbody>
  </table>
</div>
