---
interface Props { asin: string; controls?: boolean; }
const { asin, controls = false } = Astro.props;
---
<div data-commerce-observation={asin} hidden class="mt-3 text-sm text-slate-700">
  <p class="font-semibold">Price snapshot</p>
  <p data-commerce-price class="text-2xl font-black text-slate-950"></p>
  <p data-commerce-source class="mt-1 break-words text-sm text-slate-600"></p>
  <p data-commerce-availability class="mt-1 font-semibold"></p>
  {controls && <div data-commerce-controls class="mt-3">
    <p data-commerce-status role="status" class="text-sm leading-relaxed text-slate-600"></p>
    <button data-commerce-refresh type="button" class="mt-3 min-h-11 rounded-2xl border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-blue-100 disabled:opacity-60">Refresh price</button>
  </div>}
</div>
